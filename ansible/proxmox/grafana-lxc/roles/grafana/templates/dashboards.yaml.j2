apiVersion: 1
providers:
  - name: homelab
    folder: Homelab
    type: file
    # Dashboards built in the UI live in the database and are unaffected. One kept as JSON
    # here is read-only in the UI; change the file instead.
    allowUiUpdates: false
    options:
      path: /var/lib/grafana/dashboards
  # One board per inventory host, written by the role. Kept apart so the overview is not
  # lost among them.
  - name: hosts
    folder: Hosts
    type: file
    allowUiUpdates: false
    options:
      path: /var/lib/grafana/dashboards-hosts
