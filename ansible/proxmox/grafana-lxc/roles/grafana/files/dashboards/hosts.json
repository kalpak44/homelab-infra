  "panels": [
    {
      "type": "row",
      "title": "Hosts",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Hosts",
      "description": "Click a host for its own dashboard. CPUs and RAM are what each guest is given, not the node's: lxcfs reports a container's own limits. Disk sums every real filesystem on the host. CPU % is the last 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, kind) (node_uname_info{job=~\"hosts|node\",kind!=\"\"})",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (host) (node_cpu_seconds_total{job=~\"hosts|node\",mode=\"idle\"})",
          "refId": "B",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{job=~\"hosts|node\",mode=\"idle\"}[5m])))",
          "refId": "C",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (node_memory_MemTotal_bytes{job=~\"hosts|node\"})",
          "refId": "D",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - max by (host) (node_memory_MemAvailable_bytes{job=~\"hosts|node\"}) / max by (host) (node_memory_MemTotal_bytes{job=~\"hosts|node\"}))",
          "refId": "E",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (node_filesystem_size_bytes{job=~\"hosts|node\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"})",
          "refId": "F",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (node_filesystem_size_bytes{job=~\"hosts|node\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"} - node_filesystem_avail_bytes{job=~\"hosts|node\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"})",
          "refId": "G",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (node_filesystem_avail_bytes{job=~\"hosts|node\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"})",
          "refId": "H",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - sum by (host) (node_filesystem_avail_bytes{job=~\"hosts|node\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"}) / sum by (host) (node_filesystem_size_bytes{job=~\"hosts|node\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"}))",
          "refId": "I",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "renameByName": {
              "host": "Host",
              "kind": "Kind",
              "Value #B": "CPUs",
              "Value #C": "CPU %",
              "Value #D": "RAM total",
              "Value #E": "RAM used %",
              "Value #F": "Disk total",
              "Value #G": "Disk used",
              "Value #H": "Disk free",
              "Value #I": "Disk used %"
            },
            "indexByName": {
              "host": 0,
              "kind": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9
            }
          }
        }
      ],
      "options": {
