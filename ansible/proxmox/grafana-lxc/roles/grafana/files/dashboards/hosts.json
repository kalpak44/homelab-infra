        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, mountpoint) (node_filesystem_size_bytes{job=~\"hosts|node\",host=~\"$host\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"})",
          "refId": "A",
          "editorMode": "code",
