{
  "uid": "homelab-hosts",
  "title": "Homelab hosts",
  "description": "CPU, memory and disk of every LXC, VM and the Proxmox node.",
  "tags": [
    "homelab",
    "node_exporter"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{job=~\"hosts|node\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(node_uname_info{job=~\"hosts|node\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Hosts",
      "description": "Every LXC and VM and the Proxmox node. CPUs and RAM are what each guest is given, not the node's: lxcfs reports the container's own limits. Disk sums every real filesystem on the host; the table below splits them by mount. CPU % is the last 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, kind) (node_uname_info{job=~\"hosts|node\",host=~\"$host\",kind!=\"\"})",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (host) (node_cpu_seconds_total{job=~\"hosts|node\",host=~\"$host\",mode=\"idle\"})",
          "refId": "B",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{job=~\"hosts|node\",host=~\"$host\",mode=\"idle\"}[5m])))",
          "refId": "C",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (node_memory_MemTotal_bytes{job=~\"hosts|node\",host=~\"$host\"})",
          "refId": "D",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - max by (host) (node_memory_MemAvailable_bytes{job=~\"hosts|node\",host=~\"$host\"}) / max by (host) (node_memory_MemTotal_bytes{job=~\"hosts|node\",host=~\"$host\"}))",
          "refId": "E",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (node_filesystem_size_bytes{job=~\"hosts|node\",host=~\"$host\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"})",
          "refId": "F",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (node_filesystem_size_bytes{job=~\"hosts|node\",host=~\"$host\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"} - node_filesystem_avail_bytes{job=~\"hosts|node\",host=~\"$host\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"})",
          "refId": "G",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (node_filesystem_avail_bytes{job=~\"hosts|node\",host=~\"$host\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"})",
          "refId": "H",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - sum by (host) (node_filesystem_avail_bytes{job=~\"hosts|node\",host=~\"$host\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"}) / sum by (host) (node_filesystem_size_bytes{job=~\"hosts|node\",host=~\"$host\",fstype=~\"ext4|xfs|btrfs|zfs\",mountpoint!~\"/boot.*\"}))",
          "refId": "I",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "renameByName": {
              "host": "Host",
              "kind": "Kind",
              "Value #A": "",
              "Value #B": "CPUs",
              "Value #C": "CPU %",
              "Value #D": "RAM total",
              "Value #E": "RAM used %",
              "Value #F": "Disk total",
              "Value #G": "Disk used",
              "Value #H": "Disk free",
              "Value #I": "Disk used %"
            },
            "indexByName": {
              "host": 0,
              "kind": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #A": 10
