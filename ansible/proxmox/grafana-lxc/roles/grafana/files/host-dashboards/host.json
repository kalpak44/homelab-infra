          "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{job=~\"hosts|node\",host=\"__HOST__\",mode!=\"idle\"}[$__rate_interval])) / scalar(count(node_cpu_seconds_total{job=~\"hosts|node\",host=\"__HOST__\",mode=\"idle\"}))",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
