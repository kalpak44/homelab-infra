          "expr": "100 * (1 - max(node_memory_MemAvailable_bytes{job=~\"hosts|node\",host=\"__HOST__\"}) / max(node_memory_MemTotal_bytes{job=~\"hosts|node\",host=\"__HOST__\"}))",
