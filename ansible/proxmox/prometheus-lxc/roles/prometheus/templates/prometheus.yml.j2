global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    scheme: {{ 'https' if prometheus_tls_enabled else 'http' }}
{% if prometheus_tls_enabled %}
    # The self-scrape dials loopback, which no certificate for the public name
    # can match. Verification here would only check Prometheus against itself.
    tls_config:
      insecure_skip_verify: true
{% endif %}
    static_configs:
      - targets: ["localhost:{{ prometheus_port }}"]

  - job_name: node
    static_configs:
      - targets: ["localhost:{{ node_exporter_port }}"]
        labels:
          host: {{ inventory_hostname }}
          kind: lxc

  # kind comes from the inventory group, so dashboards can tell the node, its
  # containers and its VMs apart without a list of their own.
  - job_name: hosts
    static_configs:
{% for h in node_exporter_scrape_hosts %}
      - targets: ["{{ h }}.{{ node_exporter_scrape_domain }}:{{ node_exporter_port }}"]
        labels:
          host: {{ h }}
          kind: {{ 'proxmox' if h in groups['proxmox_host'] else 'lxc' if h in groups['lxc'] else 'vm' }}
{% endfor %}

  # Each target is handed to blackbox_exporter as ?target=, so the instance label keeps the
  # probed address rather than the exporter's.
  - job_name: probes
    metrics_path: /probe
    static_configs:
{% for p in prometheus_probes %}
      - targets: ["{{ p.target }}"]
        labels:
          service: {{ p.service }}
          probe: {{ p.module }}
          __param_module: {{ p.module }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__address__]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ blackbox_exporter_port }}
{% for job in prometheus_extra_scrape_jobs %}

  - job_name: {{ job.name }}
{% if job.scheme is defined %}
    scheme: {{ job.scheme }}
{% endif %}
{% if job.metrics_path is defined %}
    metrics_path: {{ job.metrics_path }}
{% endif %}
    static_configs:
      - targets: {{ job.targets | to_json }}
{% endfor %}
