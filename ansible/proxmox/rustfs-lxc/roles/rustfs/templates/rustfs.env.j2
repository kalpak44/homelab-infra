# Managed by ansible/proxmox/rustfs-lxc/roles/rustfs — edits here are overwritten.
RUSTFS_ACCESS_KEY={{ rustfs_access_key }}
RUSTFS_SECRET_KEY={{ rustfs_secret_key }}
RUSTFS_VOLUMES={{ rustfs_data_dir }}
RUSTFS_ADDRESS=:{{ rustfs_api_port }}
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CONSOLE_ADDRESS=:{{ rustfs_console_port }}
RUSTFS_SERVER_DOMAINS={{ rustfs_domain }}
RUSTFS_TLS_PATH={{ rustfs_tls_dir }}
RUSTFS_OBS_LOGGER_LEVEL=error
RUSTFS_OBS_LOG_DIRECTORY=/var/log/rustfs/
