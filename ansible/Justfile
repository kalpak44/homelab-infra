# Homelab Ansible
#
# Usage:
#   Bootstrap: run just apply in 00-bootstrap/<part>/ (see docs/1 - Bootstrap.md)
#   just configure <resource>          # per-service config, e.g. just configure adguard-lxc
#   just configure k3s-cluster/flux    # runs the flux-install.yml variant
#   just list                          # show all configurable resources
#
# Env vars come from the ignored root .env or your local shell:
#   CLOUDFLARE_API_TOKEN, LETSENCRYPT_EMAIL   (service TLS)
#   ADGUARD_USERNAME/PASSWORD, VAULT_USERNAME/PASSWORD,
#   POSTGRESQL_USER/PASSWORD/DB, PGADMIN_EMAIL/PASSWORD,
#   REDIS_PASSWORD, REDIS_COMMANDER_USER/PASSWORD,
#   FLUX_GITHUB_TOKEN
#   SSH_PRIVATE_KEY (base64 of the operator key; the only way into every LXC/VM)

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set dotenv-load := true

_help:
    @just --list

# Store local operator inputs in Vault without replacing differing values
secrets-store:
    @python3 03-vault/operator-secrets/secrets.py store

# Check that every workflow credential can be recovered from Vault
secrets-check:
    @python3 03-vault/operator-secrets/secrets.py check

# Recreate the ignored root .env from an authenticated Vault session
secrets-restore:
    @python3 03-vault/operator-secrets/secrets.py restore-env

# Repopulate this repository's Actions secrets from Vault
secrets-sync:
    @python3 03-vault/operator-secrets/secrets.py sync-github

# Install passlib, which the AdGuard and mihal roles hash passwords with. Idempotent.
[private]
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! python3 -c 'import passlib' 2>/dev/null; then
      if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update -qq
        sudo apt-get install -y python3-passlib
      elif command -v brew >/dev/null 2>&1; then
        brew install python-passlib 2>/dev/null || true
      else
        echo "install manually: python3-passlib" >&2
        exit 1
      fi
    fi

# Run the playbook for a service (or k3s-cluster/flux)
configure resource: setup
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{resource}}" in
      k3s-cluster) playbook="02-platform/k3s-cluster/cluster-setup.yml" ;;
      k3s-cluster/flux) playbook="04-gitops/flux/playbook.yml" ;;
      node-exporter) playbook="90-maintenance/node-exporter.yml" ;;
      adguard-lxc) playbook="01-networking/adguard-lxc/playbook.yml" ;;
      nfs-vm) playbook="02-platform/nfs-vm/playbook.yml" ;;
      vault-lxc) playbook="03-vault/vault-lxc/playbook.yml" ;;
      cloudflared-lxc) playbook="05-services/cloudflared-lxc/playbook.yml" ;;
      mihal-lxc) playbook="05-services/mihal-lxc/playbook.yml" ;;
      postgres-lxc) playbook="05-services/postgres-lxc/playbook.yml" ;;
      redis-lxc) playbook="05-services/redis-lxc/playbook.yml" ;;
      prometheus-lxc) playbook="05-services/prometheus-lxc/playbook.yml" ;;
      grafana-lxc) playbook="05-services/grafana-lxc/playbook.yml" ;;
      rustfs-lxc) playbook="05-services/rustfs-lxc/playbook.yml" ;;
      nocobase-lxc) playbook="05-services/nocobase-lxc/playbook.yml" ;;
      portainer-vm) playbook="05-services/portainer-vm/playbook.yml" ;;
      *) echo "Unknown resource: {{resource}}. Run just list." >&2; exit 1 ;;
    esac
    keyfile="$(mktemp)"
    trap 'rm -f "$keyfile"' EXIT
    bash shared/operator-key.sh "$keyfile"
    # mihal-lxc's cloudflared points at its own dedicated Tunnel, not the shared
    # homelab one, so its token is read live from that dir's Terraform state
    # rather than stored as a second GitHub secret.
    cloudflare_tunnel_token_mihal=""
    if [[ "{{resource}}" == "mihal-lxc" ]]; then
      cloudflare_tunnel_token_mihal="$(cd ../terraform && just output cloudflare tunnels/mihal tunnel_token)"
    fi
    ansible-playbook "$playbook" --private-key "$keyfile" \
      -e "cloudflare_tunnel_token_mihal=${cloudflare_tunnel_token_mihal}" \
      -e "cloudflare_api_token=${CLOUDFLARE_API_TOKEN:-}" \
      -e "letsencrypt_email=${LETSENCRYPT_EMAIL:-}" \
      -e "adguard_username=${ADGUARD_USERNAME:-}" \
      -e "adguard_password=${ADGUARD_PASSWORD:-}" \
      -e "vault_username=${VAULT_USERNAME:-}" \
      -e "vault_password=${VAULT_PASSWORD:-}" \
      -e "postgresql_user=${POSTGRESQL_USER:-}" \
      -e "postgresql_password=${POSTGRESQL_PASSWORD:-}" \
      -e "postgresql_db=${POSTGRESQL_DB:-}" \
      -e "pgadmin_email=${PGADMIN_EMAIL:-}" \
      -e "pgadmin_password=${PGADMIN_PASSWORD:-}" \
      -e "redis_password=${REDIS_PASSWORD:-}" \
      -e "redis_commander_user=${REDIS_COMMANDER_USER:-}" \
      -e "redis_commander_password=${REDIS_COMMANDER_PASSWORD:-}" \
      -e "flux_github_token=${FLUX_GITHUB_TOKEN:-}" \
      -e "cloudflare_tunnel_token=${CLOUDFLARE_TUNNEL_TOKEN:-}"

# The play order in 90-maintenance/os-update.yml is deliberate - do not narrow it by editing
# the playbook, pass `host` instead.
# Patch every LXC/VM and reboot what needs it (host limits the run to one)
os-update host='':
    #!/usr/bin/env bash
    set -euo pipefail
    limit_args=()
    if [[ -n "{{host}}" ]]; then
      limit_args=(--limit "{{host}}")
    fi
    keyfile="$(mktemp)"
    trap 'rm -f "$keyfile"' EXIT
    bash shared/operator-key.sh "$keyfile"
    ansible-playbook 90-maintenance/os-update.yml ${limit_args[@]+"${limit_args[@]}"} \
      --private-key "$keyfile"

# Enforce key-only root SSH on every LXC/VM (host limits the run to one)
ssh-access host='':
    #!/usr/bin/env bash
    set -euo pipefail
    limit_args=()
    if [[ -n "{{host}}" ]]; then
      limit_args=(--limit "{{host}}")
    fi
    keyfile="$(mktemp)"
    trap 'rm -f "$keyfile"' EXIT
    bash shared/operator-key.sh "$keyfile"
    ansible-playbook 90-maintenance/ssh-access.yml ${limit_args[@]+"${limit_args[@]}"} \
      --private-key "$keyfile"

# List every configurable resource
list:
    @echo "Bootstrap (each component has its own .env and Justfile):"
    @printf "  %-30s %s\n" "00-bootstrap/<part>/Justfile" "Run just apply in the component directory; see docs/1 - Bootstrap.md"
    @echo
    @echo "Configure (per-service, run after Terraform provisions the host):"
    @printf "  %-24s %s\n" "adguard-lxc"      "AdGuard Home - network-wide DNS ad-blocker"
    @printf "  %-24s %s\n" "vault-lxc"        "HashiCorp Vault - secrets manager"
    @printf "  %-24s %s\n" "postgres-lxc"     "PostgreSQL + pgAdmin - database and web UI"
    @printf "  %-24s %s\n" "redis-lxc"        "Redis + Redis Commander - cache and web UI"
    @printf "  %-24s %s\n" "prometheus-lxc"   "Prometheus + node_exporter - metrics server, TSDB on its own volume"
    @printf "  %-24s %s\n" "grafana-lxc"      "Grafana - dashboards and alerts over Prometheus, provisioned from the role"
    @printf "  %-24s %s\n" "rustfs-lxc"       "RustFS - S3-compatible object storage, API on 443 and console on 9001"
    @printf "  %-24s %s\n" "nocobase-lxc"     "SSH hardening + nftables ingress - 80/443 and SSH 22022 open, nothing else"
    @printf "  %-24s %s\n" "nfs-vm"           "NFS server - persistent volumes for k3s"
    @printf "  %-24s %s\n" "portainer-vm"     "Portainer - Docker container management UI"
    @printf "  %-24s %s\n" "cloudflared-lxc"  "Cloudflare Tunnel daemon - WAN-less public ingress"
    @printf "  %-24s %s\n" "mihal-lxc"        "Cloudflare Tunnel daemon - isolated WARP-only SSH, no LAN access"
    @printf "  %-24s %s\n" "k3s-cluster"      "k3s cluster - 2-node control-plane + worker"
    @printf "  %-24s %s\n" "k3s-cluster/flux" "Flux CD - GitOps bootstrap on the k3s cluster"
    @printf "  %-24s %s\n" "node-exporter"    "node_exporter on the Proxmox node and every LXC/VM - CPU, memory and disk"
    @echo
    @echo "Maintenance:"
    @printf "  %-24s %s\n" "os-update [host]" "apt upgrade every LXC/VM, reboot what needs it (host limits the run)"
    @printf "  %-24s %s\n" "ssh-access [host]" "key-only root SSH on every LXC/VM; mihal keeps password login"
