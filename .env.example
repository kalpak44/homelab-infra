# Local bootstrap and recovery inputs. Copy to .env, fill values, then chmod 600 .env.
# .env is ignored by Git. Keep a protected copy off the host you may need to rebuild.
# Run direct commands from the repository root: source .env
# Justfiles load .env automatically; GitHub jobs use Actions secrets instead.
# Empty values below are placeholders, not usable credentials.

# 1. Initial Proxmox bootstrap: run locally before the runner or Vault exists.
# Bootstrap components use ansible/00-bootstrap/<part>/.env; just apply --ask-pass prompts.

# Password applied to new LXCs/VMs and the runner; Ansible uses it for SSH/sudo.
export HOST_PASSWORD=""
# Operator public key installed in provisioned guests so key-based SSH is available.
export SSH_PUBLIC_KEY=""
# Matching private key for Ansible hosts that disable passwords; base64 or raw PEM.
export SSH_PRIVATE_KEY=""
# GitHub PAT used locally to register runner VM 101. Actions has its own GITHUB_TOKEN.
export GITHUB_TOKEN=""
# Repository receiving the runner registration, normally kalpak44/homelab-infra.
export GITHUB_REPO=""
# Cloudflare token used for Proxmox TLS, guest DNS/TLS and tunnel provisioning.
export CLOUDFLARE_API_TOKEN=""
# ACME registration email required for Proxmox and guest TLS certificate issuance.
export LETSENCRYPT_EMAIL=""

# 2. Terraform state: create/reuse the R2 bucket before provisioning resources.
# Read/write S3-compatible access key for the existing Terraform state bucket.
export R2_ACCESS_KEY_ID=""
# Secret paired with R2_ACCESS_KEY_ID; these credentials are separate from AWS.
export R2_SECRET_ACCESS_KEY=""
# Account-specific R2 S3 API URL; tells Terraform where existing state is stored.
export R2_ENDPOINT=""
# Existing state bucket name. Changing it can make managed resources look absent.
export R2_BUCKET_NAME=""

# 3. Proxmox Terraform access: fill after bootstrap/01-terraform-access creates the API token.
# Proxmox HTTPS API endpoint, such as https://<node-ip>:8006.
export PROXMOX_ENDPOINT=""
# Terraform API token identity, normally terraform@pve!terraform.
export PROXMOX_USERNAME=""
# API token secret printed by bootstrap/01-terraform-access; this is not the root login password.
export PROXMOX_PASSWORD=""

# 4. DNS and Vault: establish DNS and k3s before the full Vault playbook runs.
# Admin login configured by the AdGuard role; needed to rebuild internal DNS.
export ADGUARD_USERNAME=""
# Password for that AdGuard admin account.
export ADGUARD_PASSWORD=""
# Vault HTTPS endpoint used by the recovery/sync helper and direct Vault CLI commands.
export VAULT_ADDR=""
# Userpass administrator created by the Vault role; also used by the GitHub sync job.
export VAULT_USERNAME=""
# Password used to create/access that Vault administrator, including a fresh Vault.
export VAULT_PASSWORD=""

# 5. GitHub automation and Flux: after the runner is registered and Vault is ready.
# PAT managing repository settings/secrets; required to repopulate Actions from Vault.
export GH_ADMIN_TOKEN=""
# Owner of Terraform-managed repositories; normally kalpak44.
export GH_OWNER=""
# GitHub PAT for Flux bootstrap so the cluster can pull this repository's manifests.
export FLUX_GITHUB_TOKEN=""
# DeepSeek key distributed to managed repositories' maintenance agents.
export DEEPSEEK_APIKEY=""
# SonarCloud token distributed to managed repositories that run quality gates.
export SONAR_TOKEN=""
# Original Android release signing keystore, base64; preserve it to sign app updates.
export ANDROID_KEYSTORE_BASE64=""

# 6. Service configuration: not needed for the first Proxmox/runner/Vault bootstrap.
# Initial PostgreSQL database, user and password for database service configuration.
export POSTGRESQL_DB=""
export POSTGRESQL_USER=""
export POSTGRESQL_PASSWORD=""
# pgAdmin administrator email and password configured alongside PostgreSQL.
export PGADMIN_EMAIL=""
export PGADMIN_PASSWORD=""
# Redis authentication password and separate Redis Commander UI credentials.
export REDIS_PASSWORD=""
export REDIS_COMMANDER_USER=""
export REDIS_COMMANDER_PASSWORD=""
# Homelab tunnel connector token; obtain from R2-backed Terraform output after apply.
export CLOUDFLARE_TUNNEL_TOKEN=""
# Mailjet API key pair used by Cloudflare email configuration and Auth0 SMTP setup.
export MJ_APIKEY_PUBLIC=""
export MJ_APIKEY_PRIVATE=""
# Stripe account key used by the Stripe Terraform layer for billing configuration.
export STRIPE_API_KEY=""
# Auth0 tenant and Management API machine-to-machine credentials for Terraform.
export AUTH0_DOMAIN=""
export AUTH0_CLIENT_ID=""
export AUTH0_CLIENT_SECRET=""

# 7. Optional/legacy inputs: retained for existing setups, not initial prerequisites.
# Cloudflare zone ID retained from earlier configuration; current resources name zones.
export CLOUDFLARE_ZONE_ID=""
# Legacy R2 management token; the state backend uses the access-key pair in section 2.
export R2_TOKEN_VALUE=""
# Legacy WAN IP; tunnel-based public ingress does not require this bootstrap input.
export PUBLIC_WAN_IP=""
# Retained Portainer administrator credentials; current configure recipe does not map them.
export PORTAINER_ADMIN_USERNAME=""
export PORTAINER_ADMIN_PASSWORD=""
# Retained edge-dashboard credentials; current configure recipe does not map them.
export TRAEFIK_EDGE_DASHBOARD_USER=""
export TRAEFIK_EDGE_DASHBOARD_PASSWORD=""

# 8. Optional AWS: local SSO configuration, not static AWS access keys.
# Repository-relative CLI configuration path; Terraform resolves it from the repo root.
export AWS_CONFIG_FILE="terraform/aws/config"
# Shared deployment role via local SSO; GitHub assumes the same role using OIDC.
export AWS_PROFILE="aws-terraform"
# Workload region for CLI calls; the SSO region is defined separately in aws/config.
export AWS_REGION="eu-central-1"
# Region fallback used by tools that read AWS_DEFAULT_REGION instead of AWS_REGION.
export AWS_DEFAULT_REGION="eu-central-1"
