# Homelab Terraform
#
# Usage:
#   just deploy  <layer> <resource>   # e.g. just deploy cloudflare dns/private/adguard
#   just destroy <layer> <resource>   # e.g. just destroy proxmox adguard-lxc
#
# Layers: cloudflare | proxmox | github
# Resource: subdir under the layer (see `just list`)
#
# Env vars (must be set - the workflow injects them, locally they come from your shell).
# Names match the GitHub secrets 1:1; this Justfile maps them to what terraform + the
# AWS-compatible S3 SDK expect (AWS_*, TF_VAR_*) right before terraform runs.
#
#   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ENDPOINT, R2_BUCKET_NAME     (all layers)
#   CLOUDFLARE_API_TOKEN                                                     (cloudflare layer)
#   PROXMOX_ENDPOINT, PROXMOX_USERNAME, PROXMOX_PASSWORD,
#   SSH_PUBLIC_KEY, SSH_PRIVATE_KEY, HOST_PASSWORD                          (proxmox layer)
#   GH_ADMIN_TOKEN, GH_OWNER, DEEPSEEK_APIKEY, SONAR_TOKEN                   (github layer)

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

_help:
    @just --list

# Terraform init + apply
deploy layer resource:
    #!/usr/bin/env bash
    set -euo pipefail
    export AWS_ACCESS_KEY_ID="${R2_ACCESS_KEY_ID:-}"
    export AWS_SECRET_ACCESS_KEY="${R2_SECRET_ACCESS_KEY:-}"
    export AWS_ENDPOINT_URL_S3="${R2_ENDPOINT:-}"
    export TF_VAR_cloudflare_api_token="${CLOUDFLARE_API_TOKEN:-}"

    export TF_VAR_proxmox_endpoint="${PROXMOX_ENDPOINT:-}"
    export TF_VAR_proxmox_username="${PROXMOX_USERNAME:-}"
    export TF_VAR_proxmox_password="${PROXMOX_PASSWORD:-}"
    export TF_VAR_ssh_public_key="${SSH_PUBLIC_KEY:-}"
    export TF_VAR_ssh_private_key="${SSH_PRIVATE_KEY:-}"
    export TF_VAR_host_password="${HOST_PASSWORD:-ubuntu}"

    export TF_VAR_github_owner="${GH_OWNER:-kalpak44}"
    export TF_VAR_github_token="${GH_ADMIN_TOKEN:-}"
    export TF_VAR_deepseek_api_key="${DEEPSEEK_APIKEY:-}"
    export TF_VAR_sonar_token="${SONAR_TOKEN:-}"
    cd {{layer}}/{{resource}}
    terraform init -backend-config="bucket=$R2_BUCKET_NAME" -input=false
    terraform apply -auto-approve -input=false

# Terraform init + destroy
destroy layer resource:
    #!/usr/bin/env bash
    set -euo pipefail
    export AWS_ACCESS_KEY_ID="${R2_ACCESS_KEY_ID:-}"
    export AWS_SECRET_ACCESS_KEY="${R2_SECRET_ACCESS_KEY:-}"
    export AWS_ENDPOINT_URL_S3="${R2_ENDPOINT:-}"
    export TF_VAR_cloudflare_api_token="${CLOUDFLARE_API_TOKEN:-}"

    export TF_VAR_proxmox_endpoint="${PROXMOX_ENDPOINT:-}"
    export TF_VAR_proxmox_username="${PROXMOX_USERNAME:-}"
    export TF_VAR_proxmox_password="${PROXMOX_PASSWORD:-}"
    export TF_VAR_ssh_public_key="${SSH_PUBLIC_KEY:-}"
    export TF_VAR_ssh_private_key="${SSH_PRIVATE_KEY:-}"
    export TF_VAR_host_password="${HOST_PASSWORD:-ubuntu}"

    export TF_VAR_github_owner="${GH_OWNER:-kalpak44}"
    export TF_VAR_github_token="${GH_ADMIN_TOKEN:-}"
    export TF_VAR_deepseek_api_key="${DEEPSEEK_APIKEY:-}"
    export TF_VAR_sonar_token="${SONAR_TOKEN:-}"
    cd {{layer}}/{{resource}}
    terraform init -backend-config="bucket=$R2_BUCKET_NAME" -input=false
    terraform destroy -auto-approve -input=false

# Print a sensitive terraform output (e.g. just output cloudflare shared/zero-trust tunnel_token)
output layer resource name:
    #!/usr/bin/env bash
    set -euo pipefail
    export AWS_ACCESS_KEY_ID="${R2_ACCESS_KEY_ID:-}"
    export AWS_SECRET_ACCESS_KEY="${R2_SECRET_ACCESS_KEY:-}"
    export AWS_ENDPOINT_URL_S3="${R2_ENDPOINT:-}"
    cd {{layer}}/{{resource}}
    # init writes its banner to stdout, not stderr, so it must be silenced too —
    # otherwise it is prepended to the value and `just output ... | gh secret set`
    # stores the banner along with the secret.
    terraform init -backend-config="bucket=$R2_BUCKET_NAME" -input=false -reconfigure >/dev/null 2>&1
    # -raw stays the default because it is what keeps the piping above clean, but
    # it refuses objects and lists outright (saas_customer_onboarding is one), so
    # fall back to -json rather than making every caller know which kind it is.
    terraform output -raw {{name}} 2>/dev/null || terraform output -json {{name}}

# Point the syft/grype pins at the newest upstream release, then apply what moved
bump-scanners:
    #!/usr/bin/env bash
    set -euo pipefail

    # These pins sit in generated workflow files, where no dependency updater can reach
    # them: Dependabot only scans .github/workflows/, and here they are ordinary files
    # under terraform/. Moving them by hand is what let them drift.
    export GH_TOKEN="${GH_ADMIN_TOKEN:-}"

    sha256() {
        if command -v sha256sum >/dev/null 2>&1; then
            sha256sum "$1" | cut -d' ' -f1
        else
            shasum -a 256 "$1" | cut -d' ' -f1
        fi
    }

    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT

    # Prints "<tag> <installer-sha256>". The checksum is recomputed from the tag being
    # pinned, which is why a version bump alone is not enough to move these.
    resolve() {
        local tool=$1 tag installer sum
        tag=$(gh api "repos/anchore/${tool}/releases/latest" --jq .tag_name)
        installer="${work}/${tool}-install.sh"
        curl -fsSL "https://raw.githubusercontent.com/anchore/${tool}/${tag}/install.sh" -o "$installer"
        sum=$(sha256 "$installer")

        # A release that does not install is worse than a stale pin: it fails every
        # pipeline at once, and those pipelines are what would have reported it.
        sh "$installer" -b "$work" "$tag" >/dev/null 2>&1
        "${work}/${tool}" version >/dev/null
        echo "${tool} ${tag} installs and runs" >&2

        echo "$tag $sum"
    }

    read -r syft_tag syft_sum < <(resolve syft)
    read -r grype_tag grype_sum < <(resolve grype)

    files=$(grep -rl "SYFT_VERSION:" github/*/workflows/*.yml || true)

    if [ -z "$files" ]; then
        echo "no workflow pins either scanner — nothing to bump" >&2
        exit 1
    fi

    # Saved copies, because the rollback below must put back exactly what this rewrote.
    # `git checkout --` on the directory would also discard unrelated work sitting
    # uncommitted beside it.
    changed=""

    for f in $files; do
        cp "$f" "${work}/$(echo "$f" | tr '/' '_')"

        sed -i.bak -E \
            -e "s|^( *SYFT_VERSION: ).*$|\1${syft_tag}|" \
            -e "s|^( *GRYPE_VERSION: ).*$|\1${grype_tag}|" \
            -e "s|^( *SYFT_INSTALLER_SHA256: ).*$|\1${syft_sum}|" \
            -e "s|^( *GRYPE_INSTALLER_SHA256: ).*$|\1${grype_sum}|" \
            "$f" && rm -f "${f}.bak"

        if ! cmp -s "$f" "${work}/$(echo "$f" | tr '/' '_')"; then
            changed="${changed} ${f}"
        fi
    done

    if [ -z "$changed" ]; then
        echo "syft ${syft_tag}, grype ${grype_tag} — already pinned everywhere"
        exit 0
    fi

    # The repo is the dir the file sits in, and it is applied once however many of its
    # lines moved.
    repos=$(for f in $changed; do echo "$f" | cut -d/ -f2; done | sort -u)

    echo "bumping:$(echo $repos | sed 's/^/ /')"

    if [ "${DRY_RUN:-}" = "1" ]; then
        for f in $changed; do
            cp "${work}/$(echo "$f" | tr '/' '_')" "$f"
        done
        exit 0
    fi

    cd ..
    git config user.name  "homelab-infra"
    git config user.email "homelab-infra@users.noreply.github.com"
    for f in $changed; do
        git add "terraform/${f}"
    done
    git commit -m "bump syft ${syft_tag}, grype ${grype_tag}"

    # Rebase and retry rather than fail, as the image bump does: nothing serialises this
    # against a human push, and losing that race is not a reason to leave every scanner a
    # version behind for a week.
    pushed=0
    for attempt in 1 2 3; do
        if git push; then
            pushed=1
            break
        fi

        echo "push rejected (attempt $attempt) — rebasing onto the current main" >&2

        if ! git pull --rebase --quiet; then
            git rebase --abort || true
            echo "the bump conflicts with what is already on main — resolve it by hand" >&2
            exit 1
        fi
    done

    if [ "$pushed" -ne 1 ]; then
        echo "push still rejected after 3 attempts — something is pushing to main continuously" >&2
        exit 1
    fi

    # A commit here changes nothing in the target repos until Terraform pushes the file
    # into them, so the apply is part of the bump rather than a thing to remember later.
    cd terraform
    for repo in $repos; do
        echo "applying ${repo}"
        just deploy github "$repo"
    done

