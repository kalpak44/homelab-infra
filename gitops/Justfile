# Homelab GitOps
#
# Usage:
#   just bump-images        # point the public apps at the latest published image
#   just list               # show what is tracked
#
# Env vars:
#   GH_ADMIN_TOKEN (or GITHUB_TOKEN)   read the source repos' workflow runs + push the bump
#
# The tag comes from the head SHA of the latest *successful* publish run in the source
# repo, not from the head of its default branch — that way we only ever point at an image
# that actually finished building. Every publish workflow tags with a 7-char short SHA.
#
# The image is listed per app rather than derived from the repo, because the gitops dir
# name, the source repo and the image name do not always agree — bunker-game-app is
# built from bunker-party.
#
# An app may list several comma-separated images when one repo publishes more than one —
# proklinator ships the site and its API from the same commit. They are bumped to the same
# tag in the same commit, so the pair can never drift apart. Which manifest holds which
# image is discovered by grep, so the file names do not matter.

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# gitops app dir | source repo | publish workflow | image(s), comma-separated, no tag
apps := "personal-web-page|kalpak44/kalpak44|publish-frontend.yml|ghcr.io/kalpak44/kalpak44
mite-assistant-mcp|kalpak44/mite-assistant-mcp|docker-publish.yml|ghcr.io/kalpak44/mite-assistant-mcp
bunker-game-app|kalpak44/bunker-party|build.yml|ghcr.io/kalpak44/bunker-party
proklinator|kalpak44/proklinator-app|publish.yml|ghcr.io/kalpak44/proklinator-app,ghcr.io/kalpak44/proklinator-api"

_help:
    @just --list

# `only` limits the sweep to one app; `sha` supplies its commit instead of querying.
# A publish workflow that dispatches this at the end of its own run MUST pass both: at
# that moment its run is still in_progress, so the --status success query below would
# return the *previous* commit and quietly deploy a stale image.
#
# Rewrite each app's image tag to the latest published one, then commit and push
bump-images only='' sha='':
    #!/usr/bin/env bash
    set -euo pipefail
    export GH_TOKEN="${GH_ADMIN_TOKEN:-${GITHUB_TOKEN:-}}"
    if [ -z "$GH_TOKEN" ]; then
        echo "GH_ADMIN_TOKEN (or GITHUB_TOKEN) must be set" >&2
        exit 1
    fi

    only='{{only}}'
    given_sha='{{sha}}'

    if [ -n "$given_sha" ] && [ -z "$only" ]; then
        echo "sha given without an app — pass both or neither" >&2
        exit 1
    fi

    cd "$(git rev-parse --show-toplevel)"
    bumped=()
    matched=0

    while IFS='|' read -r app repo workflow image; do
        [ -z "$app" ] && continue
        [ -n "$only" ] && [ "$app" != "$only" ] && continue
        matched=1
        dir="gitops/clusters/homelab/apps/public/${app}"

        if [ -n "$given_sha" ]; then
            sha="$given_sha"
        else
            # --event push --branch main matters: these workflows also run on
            # pull_request, but the job that actually pushes the image is gated to
            # pushes on the default branch. A successful PR run would otherwise hand us
            # a SHA that was never published, and we would point the cluster at a tag
            # that does not exist.
            #
            # `|| true` because gh exits non-zero when the workflow name does not exist
            # at all, and under `set -e` that assignment would abort the whole sweep —
            # including the apps further down the list. Renaming a publish workflow in a
            # source repo is a two-repo change and the two halves cannot land at the same
            # instant, so that window has to degrade to "skip this app", which is exactly
            # what the guard below already does for a workflow that exists but has never
            # succeeded.
            sha=$(gh run list --repo "$repo" --workflow "$workflow" \
                    --event push --branch main \
                    --status success --limit 1 --json headSha --jq '.[0].headSha // empty' \
                    2>/dev/null || true)
        fi
        if [ -z "$sha" ]; then
            echo "$app: no successful $workflow run in $repo — skipping" >&2
            continue
        fi
        new="${sha:0:7}"

        # An app can publish more than one image, and they all move to the same tag —
        # they came out of the same commit. The manifest holding each one is found by
        # grep rather than assumed to be deployment.yaml, so splitting an app across
        # files needs no change here.
        app_bumped=0
        IFS=',' read -ra images <<< "$image"
        for img in "${images[@]}"; do
            short="${img##*/}"
            file=$(grep -rlE "^ *image: ${img}:" "$dir" | head -1 || true)
            if [ -z "$file" ]; then
                echo "$app: no '${img}:<tag>' line under $dir — skipping" >&2
                continue
            fi

            current=$(sed -nE "s|^ *image: ${img}:(.*)$|\1|p" "$file" | head -1)

            if [ "$current" = "$new" ]; then
                echo "$app: $short already on $new"
                continue
            fi

            if [ "${DRY_RUN:-}" = "1" ]; then
                echo "$app: $short would bump $current -> $new"
                continue
            fi

            sed -i.bak -E "s|^( *image: ${img}:).*$|\1${new}|" "$file" && rm -f "${file}.bak"
            echo "$app: $short $current -> $new"
            app_bumped=1
        done

        # Once per app, however many of its images moved — the commit message lists
        # apps, not images.
        if [ "$app_bumped" -eq 1 ]; then
            bumped+=("$app")
        fi
    done <<< '{{ apps }}'

    if [ -n "$only" ] && [ "$matched" -eq 0 ]; then
        echo "no app named '$only' is tracked" >&2
        exit 1
    fi

    if [ ${#bumped[@]} -eq 0 ]; then
        echo "nothing to do"
        exit 0
    fi

    git config user.name  "homelab-infra"
    git config user.email "homelab-infra@users.noreply.github.com"
    git add gitops/clusters/homelab/apps/public
    git commit -m "bump $(IFS=', '; echo "${bumped[*]}") image tag(s)"
    git push
    echo "pushed — Flux will reconcile"

# Show the apps whose image tags are tracked, and where they point today
list:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(git rev-parse --show-toplevel)"
    echo "Image tags bumped by 'just bump-images':"
    while IFS='|' read -r app repo workflow image; do
        [ -z "$app" ] && continue
        dir="gitops/clusters/homelab/apps/public/${app}"
        IFS=',' read -ra images <<< "$image"
        for img in "${images[@]}"; do
            file=$(grep -rlE "^ *image: ${img}:" "$dir" | head -1 || true)
            tag=''
            if [ -n "$file" ]; then
                tag=$(sed -nE "s|^ *image: ${img}:(.*)$|\1|p" "$file" | head -1)
            fi
            printf "  %-20s %-45s now=%s  (from %s)\n" "$app" "$img" "${tag:-?}" "$workflow"
        done
    done <<< '{{ apps }}'